rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The single owner account. Mirrored in src/lib/adminConfig.ts — change both.
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'FKFGGYRAt0gJqbd2yhkGsurz80C3';
    }

    // Lock down all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Daily AI quota. Rule matches are UNIONed in Firestore — a broader rule that
    // also matches would re-grant what this one withholds — so the generic user
    // rule below explicitly excludes `stats`.
    //
    // The user may READ their allowance (the coach header shows it) but never
    // write `stats/usage`: only the Admin SDK does, from /api/coach/chat, which
    // bypasses these rules. Without this, resetting the limit would be a one-line
    // job in devtools. Other stats docs stay client-writable for future use.
    match /users/{userId}/stats/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && docId != 'usage';
    }

    // Allow users to read and write documents in their own 'users' subcollections
    // (covers exercises, routines, workoutLogs, performanceEntries and profile/profile)
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && collection != 'stats';
    }

    // User feedback. Top-level because /admin has to read across all users, which
    // the per-user rules above can never express. Anyone signed in may file one;
    // only the admin can read them back or change their status.
    match /feedback/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
